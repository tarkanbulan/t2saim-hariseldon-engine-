# =====================================================================
# T2SAIM & HARI SELDON FORTRESS .gitignore
# Epistemic Security: Local Data Only · Zero Secrets Leakage
# =====================================================================

# 1. Environment & API Secrets
.env
*.env
.env.*
secrets.json
*credentials*
*private_key*

# 2. Heavy Databases & Lakehouse Data (Veriler Asla Repoya Gitmez)
*.duckdb
*.duckdb.wal
*.duckdb.tmp
*.db
*.sqlite
*.sqlite3
*.parquet
data_lakehouse/*.duckdb
data_lakehouse/*.wal
data_lakehouse/*.parquet

# 3. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# 4. Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 5. OS & IDE Specifics
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo

# 6. Temporary Logs & Dumps
*.tmp
*.temp
archive/
